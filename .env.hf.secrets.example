# Copy to .env.hf.secrets (gitignored), fill values, then:
#   hf spaces secrets add Charleschtsoi/lunglens-backend --secrets-file .env.hf.secrets
#
# Generate API_KEY: openssl rand -hex 32
# Use the SAME value for Vercel BACKEND_API_KEY.

API_KEY=REPLACE_WITH_openssl_rand_hex_32

# Optional: server-side Gemini when users do not supply BYOK gemini_api_key on analyze
# GEMINI_API_KEY=
