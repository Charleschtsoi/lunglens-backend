# Copy to `.env` and adjust paths. Used only for local development (see README).
# Deployment (HF / Docker): set these in the host UI instead of committing `.env`.

ENVIRONMENT=development

# CORS: * is fine for local; production must list real frontend origins only.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*

# No API key required locally unless you set REQUIRE_API_KEY=true
REQUIRE_API_KEY=false
# API_KEY=dev-secret-optional
# If true, startup fails when any enabled model file path does not exist.
# Recommended true for local/dev to avoid unnoticed degraded mode.
# FAIL_STARTUP_ON_MISSING_ENABLED_MODELS=true

# Optional: ML Model 1 PyTorch ResNet50 (.pth state_dict)
ENABLE_MODEL1=false
# Legacy: ENABLE_MODEL1_PYTORCH is still read if ENABLE_MODEL1 is not set.
# MODEL1_PATH=models/best_resnet50_lunglens_cleaner.pth
# Legacy: MODEL1_PTH_PATH
# MODEL1_LABELS=Normal,Pneumonia-Bacteria,Pneumonia-Virus

# Optional: ML Model 2 H5 (use an absolute path if the file is outside the repo)
ENABLE_MODEL2_H5=false
# Legacy: ENABLE_H5_MODEL is still read if ENABLE_MODEL2_H5 is not set.
# H5_MODEL2_PATH=/absolute/path/to/resnet152v2_lung_disease_final.h5
# Legacy: H5_MODEL_PATH
# Index order MUST match the model's softmax outputs [0],[1],[2] from training — not "logical" name order.
# Common cases: (A) default / Normal first → Normal,Lung_Opacity,Viral_Pneumonia  (B) alphabetical folders → Lung_Opacity,Normal,Viral_Pneumonia
H5_MODEL2_LABELS=Normal,Lung_Opacity,Viral_Pneumonia
# Legacy: H5_STAGE2_LABELS
# If true, provenance.run_mode is "real" when ML Model 2 H5 inference succeeds (default: hybrid while ML Model 1 is still mock).
# STAGE2_COUNTS_AS_FULL_REAL_RUN_MODE=false

# Optional: COPD tabular screening model (Keras + scaler.pkl)
ENABLE_COPD_MODEL=true
COPD_MODEL_PATH=models/copd_screening_model.h5
COPD_SCALER_PATH=models/scaler.pkl

# Optional: DenseNet-121 standalone endpoint POST /predict/densenet (COVID-19, Normal, Pneumonia + Grad-CAM)
ENABLE_DENSENET121=true
DENSENET121_PATH=models/best_densenet121_lunglens.pth
# DenseNet class mapping is hard-coded in backend:
#   0: Normal, 1: Pneumonia-Bacteria, 2: Pneumonia-Virus

# Optional: ML Model 4 Swin-T (auto-enabled when a weights file exists under models/)
# ENABLE_MODEL4_SWINT=true
# MODEL4_SWINT_PATH=models/best_swin_t_chestxray_6class.pth
# If unset, the first existing file among best_swint_lunglens.pth / best_swin_t_chestxray_6class.pth is used.
# Class order MUST match training ImageFolder (alphabetical folder names), index 0..N-1:
# MODEL4_SWINT_LABELS=COVID-19,Lung_Opacity,Normal,Pneumonia,Tuberculosis,Viral_Pneumonia

# Optional: ML Model 5 Keras DenseNet-121 H5 (auto-enabled when models/best_model_DENSENET121.h5 exists)
# ENABLE_MODEL5_DENSENET=true
# MODEL5_DENSENET_PATH=models/best_model_DENSENET121.h5
# Class order MUST match training (index 0..N-1). Checkpoint is 14-class NIH ChestX-ray by default:
# MODEL5_DENSENET_LABELS=Atelectasis,Cardiomegaly,Consolidation,Edema,Effusion,Emphysema,Fibrosis,Hernia,Infiltration,Mass,Nodule,Pleural_Thickening,Pneumonia,Pneumothorax

MAX_UPLOAD_MB=10

# AI Clinical Educator (Gemini): optional server key if the browser does not send gemini_api_key.
# Multipart field name must be gemini_api_key (matches Next.js BFF proxy).
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# Optional: preferred Gemini model (must exist for your API key). If unset, the backend
# discovers models via list_models() and picks the best flash model automatically.
# GEMINI_MODEL=gemini-2.5-flash
# Optional extra model ids (only used if they appear in list_models for your key).
# GEMINI_MODEL_FALLBACKS=
